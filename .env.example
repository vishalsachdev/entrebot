# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# WhatsApp Configuration (optional for MVP)
WHATSAPP_SESSION_PATH=./whatsapp_session

# Market Research Configuration (optional, for citation-backed validation)
MARKET_RESEARCH_PROVIDER=auto   # auto|tavily|serpapi
TAVILY_API_KEY=
SERPAPI_KEY=
MARKET_RESEARCH_MAX_RESULTS=5

# Security (REQUIRED)
JWT_SECRET=your_jwt_secret_key_here  # Required - generate with: openssl rand -base64 32

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
