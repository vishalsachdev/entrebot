# =============================================================================
# TEST ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains FAKE/TEST credentials for the test environment.
# These are NOT real credentials and are safe to commit to version control.
# This file is intentionally tracked in git for CI/CD pipelines.
# =============================================================================

# Supabase - Local test instance
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=test-anon-key-for-testing
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

# OpenAI - Fake key for mocked tests
OPENAI_API_KEY=sk-test-key-not-real

# JWT - Test secret (must be at least 32 characters)
JWT_SECRET=test-jwt-secret-at-least-32-characters-long

# Application Settings
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Rate Limiting - Relaxed for tests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
