# API Configuration (relative path uses Vite proxy in dev)
VITE_API_URL=/api/v1

# Optional explicit auth redirect URL (recommended for production)
# Example: https://entrebot.vercel.app/login
VITE_AUTH_REDIRECT_URL=

# Supabase Configuration (required for Illinois authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Environment
VITE_NODE_ENV=development
